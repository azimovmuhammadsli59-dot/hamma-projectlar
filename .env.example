# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Contact Form Email Delivery (Optional - configure one provider to enable direct server email sending)
# Option A: Resend API
RESEND_API_KEY=
# Option B: SMTP Server (e.g., Gmail App Password, SendGrid, Postmark, Mailgun)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Recipient and Sender addresses
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
